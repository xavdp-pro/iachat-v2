{
  "name": "iachat-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1 --port 7598\" \"PORT=7608 node --watch --watch-path=./server server/index.js\"",
    "dev:api": "PORT=7608 node --watch --watch-path=./server server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview --port 4188 --host 127.0.0.1",
    "preview:nginx": "vite preview --host 127.0.0.1 --port 7598 --strictPort",
    "start:stack": "concurrently \"npm run preview:nginx\" \"npm run dev:api\"",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:dev": "pm2 start ecosystem.dev.config.cjs",
    "pm2:switch:dev": "pm2 stop zeruxcomm-api zeruxcomm-vite 2>/dev/null; pm2 delete zeruxcomm-api zeruxcomm-vite 2>/dev/null; pm2 start ecosystem.dev.config.cjs",
    "pm2:switch:prod": "pm2 stop zeruxcomm-api-dev zeruxcomm-vite-dev 2>/dev/null; pm2 delete zeruxcomm-api-dev zeruxcomm-vite-dev 2>/dev/null; pm2 start ecosystem.config.cjs",
    "check:ollama": "node scripts/check-ollama.mjs",
    "check:pdf-designations": "node scripts/check-pdf-designation-format.mjs",
    "playwright:install": "node node_modules/playwright/cli.js install chromium",
    "test:hubspot": "node scripts/test-hubspot-contacts.mjs",
    "test:hubspot:crm": "node scripts/test-hubspot-crm.mjs",
    "imap:seed": "node infra/imap-test/seed/build-maildir.mjs",
    "imap:test:up": "npm run imap:seed && docker compose -f infra/imap-test/docker-compose.yml up -d --build",
    "imap:test:down": "docker compose -f infra/imap-test/docker-compose.yml down",
    "imap:test:logs": "docker compose -f infra/imap-test/docker-compose.yml logs -f --tail=50",
    "test:imap": "node scripts/test-imap.mjs",
    "test:graph-draft": "node scripts/test-graph-draft.mjs",
    "test:version-tree": "node scripts/test-version-tree.mjs",
    "test:hive-pdf": "node scripts/render-hive-sample-pdf.mjs /tmp/hive-sample.pdf",
    "test:detail-pdf": "node scripts/render-detail-sample-pdf.mjs /tmp/detail-sample.pdf",
    "test:recette-all": "node scripts/test-recette-all.mjs",
    "test:recette-suisse": "node scripts/recette-transport-suisse.mjs",
    "test:equipment-cr4": "node scripts/test-equipment-cr4.mjs",
    "test:equipment-matrix": "node scripts/test-equipment-matrix.mjs",
    "test:equipment-performance": "node scripts/test-equipment-performance.mjs",
    "generate:equipment-xlsx": "node scripts/generate-equipment-xlsx-cr5-cr6.mjs",
    "import:equipment": "node scripts/import-equipment-defaults.mjs",
    "test:export-xlsx": "node scripts/test-export-xlsx.mjs",
    "test:performance-compat": "node scripts/test-performance-compat.mjs",
    "extract:rules-md": "node scripts/extract-rules-from-markdown.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@qdrant/js-client-rest": "^1.17.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "fastembed": "^2.1.0",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.1",
    "imapflow": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.7.0",
    "mailparser": "^3.9.10",
    "multer": "^2.1.1",
    "mysql2": "^3.20.0",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.59.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "react-select": "^5.10.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2",
    "uuid": "^13.0.0",
    "xmlrpc": "^1.3.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "vite": "^8.0.1"
  }
}
