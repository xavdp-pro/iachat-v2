# Example nginx vhost for https://devis.zerux.com/ -> Vite on 127.0.0.1:7598
# Vite proxies /api and /uploads to Express on 127.0.0.1:7608.
#
# Copy to /etc/nginx/sites-available/devis.zerux.com.conf, adjust SSL paths if needed,
# enable it with a symlink in sites-enabled, then test + reload nginx:
#   nginx -t && systemctl reload nginx
#
# Useful checks on the server:
#   ss -tlnp | grep -E '7598|7608'
#   pm2 list

# WebSocket upgrade map, required for Vite HMR and any WebSocket proxy.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name devis.zerux.com;
    return 301 https://$host$request_uri;
}

# HTTP/1.1 only: WebSocket upgrade to Vite HMR is unreliable with http2 on some nginx builds.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name devis.zerux.com;

    ssl_certificate     /etc/nginx/ssl/zerux_chain.cer;
    ssl_certificate_key /etc/nginx/ssl/zerux.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Single entry point: Vite (:7598) proxies /api + /uploads to Express (:7608).
    location / {
        set_real_ip_from  127.0.0.1;
        real_ip_header    X-Forwarded-For;
        real_ip_recursive on;

        client_max_body_size 50m;
        proxy_pass         http://127.0.0.1:7598;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        $connection_upgrade;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
        proxy_buffering    off;
    }
}