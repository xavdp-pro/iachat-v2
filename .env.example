# ZERUX IA (iachat-v2 tree) — copy to .env and adjust (never commit .env)
# Ports: v1 uses Vite 7597 + API 7598; v2 uses Vite 7598 + API 7608

PORT=7608

# Production app URL (SPA + login): https://devis.zerux.com/login
# Hostname public pour Vite/HMR derrière nginx (lu par vite.config.js) :
VITE_DEV_PUBLIC_URL=https://devis.zerux.com
# Dev sur autre sous-domaine, ex. : VITE_DEV_PUBLIC_URL=https://zeruxcom-ds.zerux.com
# Alternative explicite (sans parser l’URL) : VITE_HMR_CLIENT_HOST=devis.zerux.com
# Optional: VITE_HMR_TIMEOUT_MS=60000 (WS handshake)
# If nginx cannot proxy WebSockets: VITE_DISABLE_HMR=1 (no hot reload; use full refresh)

# MariaDB — DB_USER / DB_NAME are usually the same app id (e.g. iachat-v2).
# Password is read from /apps/{DB_NAME}/etc/mysql/localhost/passwd when that file exists.
# Example on zeruxcomm host (schema in shared DB): DB_USER=zeruxcomm-v1 DB_NAME=zeruxcomm-v1
DB_USER=iachat-v2
DB_NAME=iachat-v2
# DB_PASSWORD=only_if_no_passwd_file

JWT_SECRET=change-me-in-production

# vLLM (OpenAI-compatible API: POST /v1/chat/completions)
OLLAMA_ENABLED=1
OLLAMA_BASE_URL=http://localhost:8000
OLLAMA_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
# Comma-separated hints if /v1/models fails (server-side fallback for the admin model list)
# OLLAMA_FALLBACK_MODELS=Qwen/Qwen2.5-32B-Instruct-AWQ,google/gemma-4-E4B-it
# Optional Vite build-time hints for the admin UI when GET /api/admin/ollama-settings fails (comma-separated)
# VITE_OLLAMA_MODEL_HINTS=Qwen/Qwen2.5-32B-Instruct-AWQ
# Optional system prompt for every conversation
# OLLAMA_SYSTEM_PROMPT=You are a helpful assistant. Reply concisely.

# Optional: override skin/plugin dirs (defaults: ./skins and ./plugins next to server/)
# SKINS_DIR=/custom/path/skins
# PLUGINS_DIR=/custom/path/plugins

# Optional: file uploads directory (default: ./tmp/uploads under the app)
# UPLOAD_DIR=/apps/iachat-v2/app/tmp/uploads

# --- Odoo XML-RPC ---
# ODOO_URL=https://90.63.204.132:9443
# ODOO_DB=DOORTAL_SYSTEMS_ERP
# ODOO_LOGIN=pblind
# ODOO_PASSWORD=change-me
# ODOO_SSL_VERIFY=0

# --- HubSpot CRM (page Prospects /api/prospects) — Private app token, scopes: contacts, companies, deals ---
# HUBSPOT_PRIVATE_APP_TOKEN=pat-eu1-your-token

# --- IMAP (boîte commerciale Zerux — emails entrants clients) ---
# Prod : serveur réel. Dev : serveur Dovecot de test → npm run imap:test:up
# IMAP_HOST=127.0.0.1
# IMAP_PORT=1143
# IMAP_SECURE=0
# IMAP_USER=commercial@zerux.test
# IMAP_PASS=zerux-test
# Contacts fictifs dans la seed : sophie.martin@thehive-paris.fr, achats@demo-logistics.fr, direction@hotel-riviera.fr

# --- Microsoft Graph (brouillon Outlook en réponse au mail client) ---
# App registration Azure AD : permissions application Mail.ReadWrite + admin consent.
# La boîte doit être la même que IMAP (emails entrants) pour retrouver le message source.
# MS_GRAPH_TENANT_ID=your-tenant-id
# MS_GRAPH_CLIENT_ID=your-client-id
# MS_GRAPH_CLIENT_SECRET=your-client-secret
# MS_GRAPH_MAILBOX=commercial@zerux.com
